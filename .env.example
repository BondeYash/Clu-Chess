# The standard local workflow needs no .env file:
#   docker compose up --build
# Values below document optional overrides and production requirements.

NODE_ENV=development
PORT=3000
# Optional Docker host-port override; the container still listens on PORT.
APP_PORT=3000
# Optional frontend host-port override; Next still listens on 5173 in Compose.
WEB_PORT=5173
# Keep these browser-visible origins aligned when overriding APP_PORT/WEB_PORT.
FRONTEND_APP_ORIGIN=http://localhost:5173
FRONTEND_API_ORIGIN=http://localhost:3000
FRONTEND_SOCKET_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Migration commands use this elevated, non-runtime role.
MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_POOL_MAX=20
DATABASE_TX_TIMEOUT_MS=3000
REDIS_URL=redis://HOST:6379
# Number of trusted reverse-proxy hops used to resolve client IPs. Keep 0
# when the app is exposed directly; the standard Nginx/LB topology uses 1.
TRUST_PROXY_HOPS=0

JWT_PRIVATE_KEY_FILE=/run/secrets/cluchess/jwt-private.pem
JWT_PUBLIC_KEYS_DIR=/run/secrets/cluchess/public
JWT_KID=replace-with-key-id
JWT_TTL_SECONDS=43200
JWT_CLOCK_SKEW_SECONDS=30
SESSION_COOKIE_ENABLED=true
SESSION_COOKIE_NAME=cluchess_guest
SESSION_RETENTION_DAYS=30

ORIGIN_ALLOWLIST=http://localhost:5173
TIME_INITIAL_MS=300000
TIME_INCREMENT_MS=2000
JOIN_DEADLINE_MS=20000
GRACE_MS=30000
RESERVATION_TTL_MS=30000
PRESENCE_TTL_MS=45000
QUEUE_GUARD_TTL_MS=120000
QUEUE_MAX_WAIT_MS=120000
MATCH_STATE_TTL_MS=3600000
SNAPSHOT_CACHE_TTL_MS=60000
MAX_WS_BUFFER_BYTES=8192
MAX_SOCKET_SEND_QUEUE_PACKETS=64
DRAIN_TIMEOUT_MS=15000
DRAIN_SOCKET_GRACE_MS=500
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_RECOVERY_MAX_DISCONNECTION_MS=120000
SOCKET_ADAPTER_STREAM_MAX_LEN=10000

LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACE_SAMPLE_RATIO=1
METRICS_ENABLED=true
METRICS_BEARER_TOKEN_FILE=/run/secrets/cluchess/metrics-token
INSTANCE_ID=replace-with-instance-id
# Local production-image smoke only. Never enable on a real deployment.
ALLOW_INSECURE_LOCAL_PRODUCTION=false

RL_SESSION_CREATE_LIMIT=10
RL_SESSION_CREATE_WINDOW_MS=60000
RL_SESSION_RENEW_LIMIT=30
RL_SESSION_RENEW_WINDOW_MS=60000
RL_SESSION_RESET_LIMIT=10
RL_SESSION_RESET_WINDOW_MS=60000
RL_SESSION_GET_LIMIT=60
RL_SESSION_GET_WINDOW_MS=60000
RL_QUEUE_LIMIT=5
RL_QUEUE_WINDOW_MS=10000
RL_MOVE_LIMIT=10
RL_MOVE_WINDOW_MS=1000
RL_SYNC_LIMIT=120
RL_SYNC_WINDOW_MS=60000
RL_CONNECTIONS_PER_IP=20

JOB_MATCH_DRAIN_MS=250
JOB_QUEUE_SWEEP_MS=5000
JOB_RESERVATION_RECONCILE_MS=5000
JOB_DEADLINE_SWEEP_MS=1000
JOB_ACTIVE_DRIFT_MS=15000
JOB_REVOCATION_REBUILD_MS=300000
JOB_SESSION_CLEANUP_MS=3600000
JOB_METRICS_REFRESH_MS=10000
JOB_BATCH_SIZE=100
