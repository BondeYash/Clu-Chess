        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "cluchess_mm_queue_depth",
          "legendFormat": "{{mode}} queue",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cluchess_matches_total[5m]))",
          "legendFormat": "matches/s",
          "refId": "B"
        }
      ],
      "title": "Matchmaking",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
