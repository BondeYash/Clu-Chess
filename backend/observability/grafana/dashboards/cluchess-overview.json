          "legendFormat": "cleanup {{job}}",
          "refId": "C"
        }
      ],
      "title": "Dependency and cleanup errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
