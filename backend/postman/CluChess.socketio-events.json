{
  "connection": {
    "url": "{{socketUrl}}",
    "transport": "websocket",
    "headers": {
      "Origin": "{{allowedOrigin}}"
    },
    "auth": {
      "token": "{{tokenA}}"
    },
    "ackRequired": true
  },
  "events": [
    {
      "name": "heartbeat.ping",
      "body": {
        "protocolVersion": 1,
        "eventId": "11111111-1111-4111-8111-111111111111",
        "timestamp": 0,
        "type": "heartbeat.ping",
        "payload": {}
      }
    },
    {
      "name": "queue.join",
      "body": {
        "protocolVersion": 1,
        "eventId": "22222222-2222-4222-8222-222222222222",
        "timestamp": 0,
        "type": "queue.join",
        "payload": {
          "mode": "blitz"
        }
      }
    },
    {
      "name": "queue.leave",
      "body": {
        "protocolVersion": 1,
        "eventId": "33333333-3333-4333-8333-333333333333",
        "timestamp": 0,
        "type": "queue.leave",
        "payload": {
          "mode": "blitz"
        }
      }
    },
    {
      "name": "game.ready",
      "body": {
        "protocolVersion": 1,
        "eventId": "44444444-4444-4444-8444-444444444444",
        "timestamp": 0,
        "type": "game.ready",
        "gameId": "{{gameId}}",
        "gameVersion": 0,
        "payload": {}
      }
    },
    {
      "name": "game.sync",
      "body": {
        "protocolVersion": 1,
        "eventId": "55555555-5555-4555-8555-555555555555",
        "timestamp": 0,
        "type": "game.sync",
        "gameId": "{{gameId}}",
        "gameVersion": 0,
        "payload": {}
      }
    },
    {
      "name": "move.submit",
      "body": {
        "protocolVersion": 1,
        "eventId": "66666666-6666-4666-8666-666666666666",
        "timestamp": 0,
        "type": "move.submit",
        "gameId": "{{gameId}}",
        "gameVersion": 0,
        "clientMoveId": "77777777-7777-4777-8777-777777777777",
        "payload": {
          "from": "e2",
          "to": "e4"
        }
      }
    },
    {
      "name": "game.resign",
      "body": {
        "protocolVersion": 1,
        "eventId": "88888888-8888-4888-8888-888888888888",
        "timestamp": 0,
        "type": "game.resign",
        "gameId": "{{gameId}}",
        "gameVersion": 0,
        "payload": {}
      }
    }
  ],
  "notes": [
    "Use a fresh UUID v4 for eventId on each new semantic command.",
    "Reuse the same eventId only when retrying that exact command.",
    "Use a fresh clientMoveId for each proposed move.",
    "Open two Socket.IO requests, authenticating one with tokenA and one with tokenB, to exercise matchmaking.",
    "Replace each numeric gameVersion example with the latest value from match.found, game.snapshot, move.accepted, or game.ended before sending later game commands."
  ]
}
